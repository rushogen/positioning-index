# index.rushogen.com -- the B2B SaaS Positioning Index
#
# Its own server block and its own docroot, deliberately. rushogen.com serves
# the consulting site from this same machine, and a deploy of this project must
# not be able to reach those files even if somebody types the wrong rsync flag.
#
# Install:
#   sudo cp index.rushogen.com.nginx /etc/nginx/sites-available/index.rushogen.com
#   sudo ln -s /etc/nginx/sites-available/index.rushogen.com /etc/nginx/sites-enabled/
#   sudo mkdir -p /var/www/index.rushogen.com && sudo chown -R $USER /var/www/index.rushogen.com
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d index.rushogen.com     # after the DNS A record resolves
#
# DNS first: an A record for index.rushogen.com -> 209.74.89.167.

server {
    listen 80;
    listen [::]:80;
    server_name index.rushogen.com;
    # certbot rewrites this block to redirect to 443 once the cert is issued.
    root /var/www/index.rushogen.com;
    index index.html;

    # The archive's whole argument is that a citation resolves later. Snapshot
    # URLs are content-addressed by design and never change, so they are cached
    # hard; everything else is revalidated so a crawl commit shows up promptly.
    location ^~ /api/benchmark/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        add_header Cache-Control "public, max-age=300, must-revalidate";
        types { application/json json; }
        default_type application/json;
    }

    location = /index.html {
        add_header Cache-Control "public, max-age=60, must-revalidate";
    }

    # This site makes no third-party request and sets no cookie. The policy below
    # says so in a way a browser enforces, rather than leaving it as a claim in a
    # README: if a script ever tries to reach another origin, it fails loudly
    # instead of quietly disclosing a visitor's IP.
    add_header Content-Security-Policy
        "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_types text/html text/css application/javascript application/json text/plain;
    gzip_min_length 1024;

    # docs/ is a plain directory of files. Anything not found is not a route.
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/index.rushogen.com.access.log;
    error_log  /var/log/nginx/index.rushogen.com.error.log;
}
