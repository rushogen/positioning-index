# index.rushogen.com -- the B2B SaaS Positioning Index
#
# Its own server block and its own docroot, deliberately. rushogen.com serves
# the consulting site from this same machine, and a deploy of this project must
# not be able to reach those files even if somebody types the wrong rsync flag.
#
# This is the PRE-CERTBOT template. certbot --nginx transforms it: it adds the
# listen 443 / ssl_certificate lines and splits off a port-80 -> 443 redirect
# block. Do not re-scp this over a certbot-managed file without re-running
# certbot afterwards, or you drop the TLS directives.
#
# Install (fresh):
#   sudo cp index.rushogen.com.nginx /etc/nginx/sites-available/index.rushogen.com
#   sudo cp index-security.conf /etc/nginx/snippets/index-security.conf
#   sudo ln -s /etc/nginx/sites-available/index.rushogen.com /etc/nginx/sites-enabled/
#   sudo mkdir -p /var/www/index.rushogen.com && sudo chown -R $USER /var/www/index.rushogen.com
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d index.rushogen.com --redirect
#
# DNS first: an A record for index.rushogen.com -> 209.74.89.167.

server {
    listen 80;
    listen [::]:80;
    server_name index.rushogen.com;
    root /var/www/index.rushogen.com;
    index index.html;

    # Security headers at server level cover every location that does NOT set its
    # own add_header. nginx drops ALL inherited add_header directives inside any
    # location that declares one, so every location below that sets Cache-Control
    # re-includes the same snippet. Miss that and the homepage -- which caches --
    # silently loses its CSP, which is the one header that makes "no third-party
    # request" a thing the browser enforces rather than a claim in a README.
    include snippets/index-security.conf;

    # Snapshot URLs are content-addressed and never change, so they cache for a
    # year; everything else revalidates so a crawl commit shows up promptly.
    location ^~ /api/benchmark/ {
        include snippets/index-security.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        include snippets/index-security.conf;
        add_header Cache-Control "public, max-age=300, must-revalidate";
        default_type application/json;
    }

    location = /index.html {
        include snippets/index-security.conf;
        add_header Cache-Control "public, max-age=60, must-revalidate";
    }

    gzip on;
    gzip_types text/css application/javascript application/json text/plain;
    gzip_min_length 1024;

    # docs/ is a plain directory of files. Anything not found is not a route.
    location / {
        try_files $uri $uri/ =404;
    }

    access_log /var/log/nginx/index.rushogen.com.access.log;
    error_log  /var/log/nginx/index.rushogen.com.error.log;
}
